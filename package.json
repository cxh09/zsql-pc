{
  "name": "zsql-pc",
  "version": "1.0.0",
  "description": "ZSQL PC - Electron Application with TDesign",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux"
  },
  "keywords": [
    "electron",
    "vue",
    "tdesign"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "tdesign-vue-next": "^1.20.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "electron": "^42.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zsql.pc",
    "productName": "ZSQL PC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "pages/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
